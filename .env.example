# ──────────────────────────────────────────
# Geo News Scraper – Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=geo_news

# Google APIs
GOOGLE_GEOCODING_API_KEY=your_geocoding_api_key_here
GOOGLE_MAPS_JS_API_KEY=your_maps_js_api_key_here

# Scraper schedule (cron expression)
SCRAPE_SCHEDULE_CRON=0 * * * *

# CORS – comma-separated list of allowed origins for the FastAPI backend
CORS_ORIGINS=http://localhost:5173
